{
    "name": "athul-suresh/filament-record-lock",
    "description": "A Filament v5 plugin that locks records during editing to prevent data conflicts in multi-user admin panels. Zero configuration, no migrations required",
    "keywords": [
        "Athul-Suresh",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-record-lock"
    ],
    "homepage": "https://github.com/athul-suresh/filament-record-lock",
    "support": {
        "issues": "https://github.com/athul-suresh/filament-record-lock/issues",
        "source": "https://github.com/athul-suresh/filament-record-lock"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "athul",
            "email": "athulsuresh198@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AthulSuresh\\FilamentRecordLock\\": "src/",
            "AthulSuresh\\FilamentRecordLock\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AthulSuresh\\FilamentRecordLock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "pint",
        "test": "pest",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AthulSuresh\\FilamentRecordLock\\FilamentRecordLockServiceProvider"
            ],
            "aliases": {
                "FilamentRecordLock": "AthulSuresh\\FilamentRecordLock\\Facades\\FilamentRecordLock"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}